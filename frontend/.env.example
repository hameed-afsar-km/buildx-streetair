# ========================================================
# STREETAIR FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ========================================================

# Base URL for the FastAPI backend API service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# WebSocket URL for real-time live environmental telemetry
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/live

# Primary Demonstration Station Identifier (B.S. Abdur Rahman Crescent Institute)
NEXT_PUBLIC_DEMO_STATION_ID=crescent-vandalur-01

# Firebase Client SDK Configuration (Safe for client-side bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeKeyForDevelopmentPreview
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=streetair-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=streetair-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=streetair-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Feature Flags
NEXT_PUBLIC_ENABLE_CLEAN_AIR_NAVIGATION=false
NEXT_PUBLIC_ENABLE_DEV_MOCK_FALLBACK=true

