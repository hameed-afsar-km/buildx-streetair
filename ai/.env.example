# =============================================================================
# STREETAIR AI Engine — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit a .env file containing real secrets.
# All variables marked (required) must be set for the service to start.
# =============================================================================

# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_ENV=development          # development | staging | production
AI_SERVICE_VERSION=1.0.0
AI_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# Internal Service-to-Service Authentication (required)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The main backend must include this key as: Authorization: Bearer <key>
# -----------------------------------------------------------------------------
AI_INTERNAL_API_KEY=REPLACE_WITH_STRONG_SECRET

# -----------------------------------------------------------------------------
# AI Provider Selection
# -----------------------------------------------------------------------------
AI_DEFAULT_PROVIDER=groq            # groq | ollama
AI_ENABLE_PROVIDER_FALLBACK=false   # true = fall back to secondary on failure
AI_REQUEST_TIMEOUT_SECONDS=45

# -----------------------------------------------------------------------------
# Groq Cloud (https://console.groq.com)
# -----------------------------------------------------------------------------
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile  # Configurable — check Groq docs for current models
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.2

# -----------------------------------------------------------------------------
# Ollama Local (https://ollama.ai)
# Start Ollama first: ollama serve
# Pull a model: ollama pull llama3.2:3b
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Tavily Web Search (https://tavily.com)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=REPLACE_WITH_TAVILY_API_KEY
TAVILY_SEARCH_DEPTH=basic           # basic | advanced
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# RAG / Vector Store
# -----------------------------------------------------------------------------
VECTOR_STORE_PROVIDER=chromadb      # chromadb (local) | qdrant (production)
VECTOR_STORE_PATH=./data/vectorstore  # ChromaDB local persistence path
QDRANT_URL=http://localhost:6333    # Only needed if VECTOR_STORE_PROVIDER=qdrant
QDRANT_API_KEY=                     # Optional Qdrant API key

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=local            # local (sentence-transformers) | openai
EMBEDDING_MODEL=all-MiniLM-L6-v2   # sentence-transformers model name
# OPENAI_API_KEY=                   # Only needed if EMBEDDING_PROVIDER=openai

# -----------------------------------------------------------------------------
# CORS (leave empty to disable — internal service should not be public)
# -----------------------------------------------------------------------------
AI_CORS_ALLOWED_ORIGINS=            # Comma-separated origins; empty = disabled

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Analytics & AQI
# -----------------------------------------------------------------------------
AQI_STANDARD=CPCB_INDIA            # Only CPCB_INDIA supported currently

