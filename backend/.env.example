# ============================================================
# STREETAIR Backend — Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Application ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
DEBUG=false

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Firebase ---
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account JSON file (local dev only)
# In production, use a managed identity or environment secret.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# --- AI Engine (internal service) ---
AI_ENGINE_URL=http://localhost:8001
AI_ENGINE_SERVICE_TOKEN=change-me-generate-a-secure-token

# --- Device Authentication ---
# HMAC secret for signing device tokens (generate a strong random value)
DEVICE_AUTH_SECRET=change-me-generate-a-secure-32-byte-secret

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_INGEST_PER_MINUTE=30

# --- MQTT (future hardware integration) ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=streetair/readings

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Sensor Validation Bounds ---
PM1_MAX=1500.0
PM25_MAX=1500.0
PM10_MAX=2000.0
MQ135_RAW_MAX=4095
TEMPERATURE_MIN=-20.0
TEMPERATURE_MAX=60.0
HUMIDITY_MIN=0.0
HUMIDITY_MAX=100.0
PRESSURE_MIN=800.0
PRESSURE_MAX=1100.0

# --- Timestamp Skew (seconds) ---
MAX_TIMESTAMP_FUTURE_SKEW=300
MAX_TIMESTAMP_PAST_SKEW=86400

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_USER=5

# --- Alert Cooldown ---
ALERT_COOLDOWN_SECONDS=300

